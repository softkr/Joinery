{
  "name": "dbcat-editor",
  "private": true,
  "description": "Bundles CodeMirror 6 (editor.js) and the ER diagram (erd.js, dagre) into internal/web/static (run: npm run build)",
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=iife --global-name=DBCatEditor --target=safari15 --outfile=../../internal/web/static/editor.js && esbuild src/erd.js --bundle --minify --format=iife --global-name=DBCatERD --target=safari15 --outfile=../../internal/web/static/erd.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-sql": "6.8.0",
    "@codemirror/language": "6.11.0",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.8",
    "@dagrejs/dagre": "3.1.3",
    "@lezer/highlight": "1.2.1",
    "sql-formatter": "15.9.0"
  },
  "devDependencies": {
    "esbuild": "0.25.4"
  }
}
